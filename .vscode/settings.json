    "editor.findMatchHighlightBackground": "#ff00ff53",
    "editor.selectionBackground": "#ff0000e6",
    "editor.selectionHighlightBackground": "#4a6cf391",
    "editorIndentGuide.background2": "#ff75b541",
    "editorIndentGuide.background3": "#45a8f949",
    "editorIndentGuide.background4": "#b184eb26",
    "editorIndentGuide.background5": "#e6e6e62e",
